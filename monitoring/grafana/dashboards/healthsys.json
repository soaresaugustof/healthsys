{
  "title": "HealthSys — Microservices",
  "uid": "healthsys-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Requests/s por Serviço",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (application)",
        "legendFormat": "{{application}}"
      }]
    },
    {
      "id": 2,
      "title": "Latência média (ms) por Serviço",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_sum[1m])) by (application) / sum(rate(http_server_requests_seconds_count[1m])) by (application) * 1000",
        "legendFormat": "{{application}}"
      }]
    },
    {
      "id": 3,
      "title": "Taxa de Erros HTTP 5xx",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) by (application)",
        "legendFormat": "{{application}}"
      }]
    },
    {
      "id": 4,
      "title": "Heap JVM Utilizado (MB) por Serviço",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{
        "expr": "jvm_memory_used_bytes{area=\"heap\"} / 1048576",
        "legendFormat": "{{application}} - {{id}}"
      }]
    },
    {
      "id": 5,
      "title": "CPU Usage por Serviço",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [{
        "expr": "process_cpu_usage * 100",
        "legendFormat": "{{application}}"
      }]
    },
    {
      "id": 6,
      "title": "Threads Ativas por Serviço",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [{
        "expr": "jvm_threads_live_threads",
        "legendFormat": "{{application}}"
      }]
    }
  ]
}
